# ===== 个人日记 · 本地配置模板 =====
# 复制为 .env 后按需填写。所有 AI 相关项均可选:
# 不填 AI_API_KEY 时,AI 功能会自动降级为占位提示,产品其余功能不受影响。

# AI 供应商:openai-compatible(豆包/DeepSeek/Qwen 通用) | null(禁用 AI)
AI_PROVIDER=openai-compatible

# OpenAI 兼容接口地址(任选其一,或填你自己的):
#   豆包 Doubao:  https://ark.cn-beijing.volces.com/api/v3
#   DeepSeek:     https://api.deepseek.com
#   通义 Qwen:    https://dashscope.aliyuncs.com/compatible-mode/v1
AI_BASE_URL=https://api.deepseek.com
AI_API_KEY=

# 纯文字模型(日记没有图片时使用,质量最高)
AI_TEXT_MODEL=deepseek-v4-pro
# 视觉模型(日记含图片时自动切换,支持看图)
AI_VISION_MODEL=deepseek-v4-flash-vision-exp

# 思考模式(仅纯文字模型有效;视觉模型不发送该字段):
#   disabled = 直接回答,快而省(推荐) | enabled = 更深入,慢且贵
AI_THINKING=disabled

# 服务端口(默认 4520)
PORT=4520

# 数据目录(默认 ~/.local/share/personal-diary)
DIARY_DATA_DIR=
