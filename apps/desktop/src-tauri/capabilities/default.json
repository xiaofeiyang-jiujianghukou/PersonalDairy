{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "桌面登录壳默认能力:本地应用,允许 HTTP 请求到日记服务端(跨域请求走 Rust)",
  "windows": ["main"],
  "permissions": [
    "core:default",
    {
      "identifier": "http:default",
      "allow": [
        { "url": "https://bluesheep.vip/*" },
        { "url": "http://localhost/*" }
      ]
    }
  ]
}
